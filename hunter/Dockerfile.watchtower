FROM mcr.microsoft.com/playwright/python:v1.62.0-noble

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    WATCHTOWER_DATA_DIR=/data \
    WATCHTOWER_PROFILE_DIR=/data/chromium-profile \
    WATCHTOWER_HEADLESS=true

WORKDIR /app

COPY hunter/watchtower-requirements.txt /tmp/watchtower-requirements.txt
RUN pip install --no-cache-dir -r /tmp/watchtower-requirements.txt

COPY hunter /app/hunter

RUN mkdir -p /data/chromium-profile

EXPOSE 8080

CMD ["uvicorn", "hunter.watchtower_render:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
